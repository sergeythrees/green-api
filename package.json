{
  "name": "green-api-chats",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Чат-клиент Telegram на HTTP API GREEN-API",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @green-api-chat/telegram",
    "dev:telegram": "npm run dev --workspace @green-api-chat/telegram",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:telegram": "npm run test --workspace @green-api-chat/telegram",
    "screenshots": "npm run screenshots --workspaces --if-present"
  }
}
